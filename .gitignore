# ======================================================
# UNIVERSAL .gitignore - All Languages & Frameworks
# ======================================================

# OS & SYSTEM
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# IDEs & EDITORS
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.code-workspace
.atom/
nbproject/
*.suo
*.user

# LOGS, ENV & SECRETS
logs/
*.log
npm-debug.log*
yarn-debug.log*
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
secrets/

# JAVASCRIPT / TYPESCRIPT / NODE
node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
.next/
.nuxt/
.output/
.cache/
.parcel-cache/
.turbo/
.vercel
.netlify/
dist/
build/
out/
coverage/
.eslintcache

# PYTHON
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
dist/
build/
*.whl
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
.pybuilder/
db.sqlite3
instance/

# JAVA / KOTLIN / ANDROID
*.class
*.jar
*.war
*.aar
*.apk
*.aab
target/
.gradle/
build/
local.properties
*.keystore
*.hprof

# C / C++ / C# / .NET
*.o
*.obj
*.a
*.so
*.dll
*.dylib
*.exe
*.out
*.app
*.dSYM/
*.idb
*.pdb
*.ilk
.vs/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Oo]bj/
[Bb]in/
*.nupkg
**/[Pp]ackages/*
msbuild.log

# GO
*.exe
*.test
*.out
go.work
vendor/

# RUST
/target/
**/*.rs.bk
Cargo.lock

# PHP / LARAVEL
/vendor/
composer.phar
.env.local.php
.phpunit.result.cache
Homestead.json
auth.json
.php_cs.cache

# RUBY / RAILS
*.gem
/coverage/
/pkg/
/tmp/
/.bundle/
/vendor/bundle/
.ruby-version
.byebug_history

# SWIFT / iOS / XCODE
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
DerivedData/
*.hmap
*.ipa
*.dSYM
*.xcuserstate
*.xcuserdata
Pods/
.fastlane/report.xml

# DART / FLUTTER
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# OTHER LANGUAGES
/_build/
/cover/
/deps/
/doc/
/.fetch
erl_crash.dump
*.beam
dist/
dist-newstyle/
.stack-work/
.Rproj.user/
.Rhistory
.RData
luac.out
*.tfstate
*.tfstate.*
.terraform/
crash.log

# UNITY / UNREAL / GODOT
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uilds/
[Uu]ser[Ss]ettings/
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.mono/
.import/
export.cfg
*.csproj
*.sln

# DATABASES & TEMP
*.sqlite
*.db
tmp/
temp/
.tmp/
*.tmp
.cache/

# Gitto
.gitto/
.env.gitto
gitto.out
gitto.in
gitto.db
