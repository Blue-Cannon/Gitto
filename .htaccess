# =================================================
# Gitto - Dynamic .htaccess - No gitto.db, No Front Controller
# For: Render Docker (env: docker) / CapRover / Railway
# Supports: Real files + Git Smart HTTP + 404.html
# =================================================

Options -Indexes
RewriteEngine On
RewriteBase /

# --- Custom 404 ---
ErrorDocument 404 /404.html

# --- Security: Hide sensitive files ---
<FilesMatch "^\.(env|git|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(composer\.json|composer\.lock|Dockerfile|captain-definition|render\.yaml)$">
    Require all denied
</FilesMatch>

# --- Protect repos/ and data/ from direct HTTP ---
RewriteRule ^repos/ - [F,L]
RewriteRule ^data/ - [F,L]
RewriteRule ^dist/ - [F,L]

# --- GIT SMART HTTP PROTOCOL ---
RewriteCond %{QUERY_STRING} service=git-(upload|receive)-pack [OR]
RewriteCond %{REQUEST_URI} git-(upload|receive)-pack
RewriteRule ^ - [E=GIT_REQUEST:1]

# With /git/ prefix
RewriteRule ^git/([^/]+\.git)/info/refs$ git/protocol.php?repo=$1 [L,QSA,E=GIT:1]
RewriteRule ^git/([^/]+\.git)/git-(upload|receive)-pack$ git/protocol.php?repo=$1 [L,QSA,E=GIT:1]
RewriteRule ^git/([^/]+/[^/]+\.git)/info/refs$ git/protocol.php?repo=$1 [L,QSA,E=GIT:1]
RewriteRule ^git/([^/]+/[^/]+\.git)/git-(upload|receive)-pack$ git/protocol.php?repo=$1 [L,QSA,E=GIT:1]

# Without /git/ prefix (short URLs)
RewriteRule ^([^/]+\.git)/info/refs$ git/protocol.php?repo=$1 [L,QSA,E=GIT:1]
RewriteRule ^([^/]+\.git)/git-(upload|receive)-pack$ git/protocol.php?repo=$1 [L,QSA,E=GIT:1]
RewriteRule ^([^/]+/[^/]+\.git)/info/refs$ git/protocol.php?repo=$1 [L,QSA,E=GIT:1]
RewriteRule ^([^/]+/[^/]+\.git)/git-(upload|receive)-pack$ git/protocol.php?repo=$1 [L,QSA,E=GIT:1]

# If git request, stop here
RewriteCond %{ENV:GIT_REQUEST} 1 [OR]
RewriteCond %{ENV:GIT} 1
RewriteRule ^ - [L]

# --- Serve REAL files, don't rewrite to index.php ---
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --- API only (keep, but not whole site) ---
RewriteRule ^api/(.*)$ api/index.php?path=$1 [L,QSA]

# --- REMOVED: Front Controller ---
# Old: RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]
# Now: If file doesn't exist, Apache will show 404.html via ErrorDocument

# --- Security Headers ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
    Header always set Access-Control-Allow-Origin "*"
</IfModule>
